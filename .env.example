# === Telegram (obligatorias) ===
TELEGRAM_BOT_TOKEN=123456789:AAEjemploDeTokenDeTelegram
TELEGRAM_CHANNEL_ID=@mi_canal_o_-1001234567890
TELEGRAM_USER_ID=123456789

# === Base de datos ===
# Local:
DATABASE=ofertas.db
# Railway (volumen montado en /data):
# DATABASE=/data/ofertas.db

# === Fuentes de ofertas (opcional) ===
# SLICKDEALS_URL=https://feeds.feedburner.com/SlickdealsnetFP
# DEALSNEWS_URL=https://www.dealnews.com/
# DEALSOFAMERICA_URL=https://www.dealsofamerica.com/

# === IA (opcional pero recomendada) ===
# Una o varias claves de Gemini separadas por coma.
GEMINI_API_KEYS=
# Alternativa a la lista anterior.
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
# Respaldo cuando Gemini falla o está en cuota.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# Opcional: el bot descubre automáticamente los modelos Gemini disponibles.
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.8-flash
# GEMINI_MODEL=gemini-3.5-flash
# Orden de preferencia: modelo principal elegido para el canal.
# GEMINI_MODEL_PREFERIDOS=gemini-3.6-flash
GEMINI_CALL_TIMEOUT_SECONDS=8
GROQ_CALL_TIMEOUT_SECONDS=20

# Imágenes: si Telegram no puede bajar una URL, se descarga y se sube el fichero.
DESCARGAR_IMAGENES=true
IMAGE_MAX_BYTES=5000000
IMAGE_TIMEOUT_SECONDS=20
# Si no hay ninguna imagen disponible, se usa esta imagen de respaldo.
USAR_PLACEHOLDER=true
PLACEHOLDER_IMAGE=assets/oferta_sin_imagen.jpg

# Si es true, una oferta sin gancho de IA no se publica (comportamiento antiguo).
AI_HOOK_REQUIRED=false
AI_HOOK_TIMEOUT_SECONDS=45

# === Ritmo de publicación ===
MAX_OFERTAS_POR_EJECUCION=20
# Umbral para considerar dos títulos de fuentes distintas como el mismo producto.
SIMILITUD_TITULOS_MINIMA=0.82
LOOP_INTERVAL_SECONDS=7200
SEND_OFFER_INTERVAL_SECONDS=8
SEND_OFFER_MAX_RETRIES=3
SEND_OFFER_RETRY_SLEEP_SECONDS=5
CYCLE_TIMEOUT_SECONDS=600
SCRAPER_TIMEOUT_SECONDS=60

# === Alertas ===
MAX_ALERTAS_POR_USUARIO=20
KEYWORD_MIN_LENGTH=2
KEYWORD_MAX_LENGTH=64

# === Telegram polling / webhook ===
TELEGRAM_POLLING_TIMEOUT=30
TELEGRAM_POLLING_INTERVAL=0
# USE_WEBHOOKS=false
# WEBHOOK_URL=https://tu-servicio.up.railway.app
# WEBHOOK_SECRET=una-cadena-larga-y-aleatoria
# PORT=8443

# === Operación ===
# Puerto HTTP opcional para /health (útil para healthcheck de Railway).
HEALTH_PORT=0
HEARTBEAT_INTERVAL_SECONDS=3600
HEARTBEAT_MAX_HOURS=6
DIAS_LIMPIEZA_OFERTAS_ANTIGUAS=30
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
